# Copy to .env next to docker-compose.selfhost.yml and fill in.
# Never commit .env (it is in .gitignore).

# Database password: any long random string, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Local port the site listens on (127.0.0.1 only). The Cloudflare Tunnel
# points at http://localhost:<this port>. Change it if 8189 is taken.
WEB_PORT=8189

# App worker processes. 2 is plenty for personal use; each uses ~300-500 MB.
UNICORN_WORKERS=2

# Optional: real Cloudflare Turnstile keys for shikoku.doncorleonez.my.id.
# Only needed if you later want accounts; hotseat play works without them.
# TURNSTILE_SITEKEY=
# TURNSTILE_SECRET=
# TURNSTILE_HOSTS=shikoku.doncorleonez.my.id
